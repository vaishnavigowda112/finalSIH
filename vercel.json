{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://your-render-service-url/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
